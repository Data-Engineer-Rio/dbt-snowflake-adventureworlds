USE ROLE AW_INGEST_ROLE;

CREATE OR REPLACE FILE FORMAT ADVENTUREWORKS_DE.LANDING.AW_CSV_FORMAT
  TYPE = CSV
  FIELD_DELIMITER = ','
  SKIP_HEADER = 1
  FIELD_OPTIONALLY_ENCLOSED_BY = '"'
  EMPTY_FIELD_AS_NULL = TRUE
  NULL_IF = ('', 'NULL', 'null')
  ENCODING = 'UTF8'
  ERROR_ON_COLUMN_COUNT_MISMATCH = TRUE;

CREATE OR REPLACE STAGE ADVENTUREWORKS_DE.LANDING.AW_S3_STAGE
  URL = 's3://<BUCKET>/adventureworks/'
  STORAGE_INTEGRATION = AW_S3_INT
  FILE_FORMAT = ADVENTUREWORKS_DE.LANDING.AW_CSV_FORMAT;

LIST @ADVENTUREWORKS_DE.LANDING.AW_S3_STAGE;

SELECT
  METADATA$FILENAME AS source_file,
  METADATA$FILE_ROW_NUMBER AS source_row_number,
  t.$1 AS first_column,
  t.$2 AS second_column
FROM @ADVENTUREWORKS_DE.LANDING.AW_S3_STAGE t
LIMIT 10;

